<Window x:Class="DKAerialView.AerialGenerationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AI 조감도 생성" Width="540" Height="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="시점" VerticalAlignment="Center"/>
            <ComboBox x:Name="AngleBox" Grid.Row="0" Grid.Column="1" Height="32" Margin="8">
                <ComboBoxItem Content="자동" Tag="Automatic"/>
                <ComboBoxItem Content="낮은 조감 (35°)" Tag="LowOblique"/>
                <ComboBoxItem Content="표준 조감 (50°)" Tag="StandardOblique" IsSelected="True"/>
                <ComboBoxItem Content="높은 조감 (65°)" Tag="HighOblique"/>
            </ComboBox>

            <TextBlock Grid.Row="1" Text="방향" VerticalAlignment="Center"/>
            <ComboBox x:Name="DirectionBox" Grid.Row="1" Grid.Column="1" Height="32" Margin="8">
                <ComboBoxItem Content="자동" Tag="Automatic" IsSelected="True"/>
                <ComboBoxItem Content="북" Tag="North"/>
                <ComboBoxItem Content="북동" Tag="NorthEast"/>
                <ComboBoxItem Content="동" Tag="East"/>
                <ComboBoxItem Content="남동" Tag="SouthEast"/>
                <ComboBoxItem Content="남" Tag="South"/>
                <ComboBoxItem Content="남서" Tag="SouthWest"/>
                <ComboBoxItem Content="서" Tag="West"/>
                <ComboBoxItem Content="북서" Tag="NorthWest"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Text="구조 보존" VerticalAlignment="Center"/>
            <ComboBox x:Name="PreservationBox" Grid.Row="2" Grid.Column="1" Height="32" Margin="8">
                <ComboBoxItem Content="높음" Tag="High" IsSelected="True"/>
                <ComboBoxItem Content="보통" Tag="Medium"/>
            </ComboBox>

            <TextBlock Grid.Row="3" Text="스타일" VerticalAlignment="Center"/>
            <ComboBox x:Name="StyleBox" Grid.Row="3" Grid.Column="1" Height="32" Margin="8">
                <ComboBoxItem Content="사실적 조감도" Tag="Realistic" IsSelected="True"/>
                <ComboBoxItem Content="깔끔한 건축 조감도" Tag="Architectural"/>
            </ComboBox>

            <TextBlock Grid.Row="4" Text="출력 크기" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="4" Grid.Column="1" Margin="8">
                <CheckBox x:Name="UseCurrentOutputCheckBox" Content="현재 출력 프리셋 사용" IsChecked="True"
                          Checked="UseCurrentOutputCheckBox_Changed" Unchecked="UseCurrentOutputCheckBox_Changed"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="WidthBox" Grid.Column="0" Height="32" IsEnabled="False"/>
                    <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox x:Name="HeightBox" Grid.Column="2" Height="32" IsEnabled="False"/>
                </Grid>
            </StackPanel>

            <Separator Grid.Row="5" Grid.ColumnSpan="2" Margin="0,14,0,14"/>

            <TextBlock Grid.Row="6" Text="카카오 로드뷰 참조" VerticalAlignment="Top" Margin="0,5,0,0"/>
            <StackPanel Grid.Row="6" Grid.Column="1" Margin="8">
                <CheckBox x:Name="UseRoadviewCheckBox" Content="주변 카카오 로드뷰를 AI 참조 이미지로 사용" IsChecked="True"/>
                <TextBlock Margin="0,5,0,0" Foreground="#666" TextWrapping="Wrap"
                           Text="항공사진은 배치 기준으로, 로드뷰는 건물 높이·외벽·지붕 형태 추정에 사용합니다."/>
            </StackPanel>

            <TextBlock Grid.Row="7" Text="로드뷰 거리" VerticalAlignment="Center"/>
            <ComboBox x:Name="RoadviewDistanceBox" Grid.Row="7" Grid.Column="1" Height="32" Margin="8">
                <ComboBoxItem Content="50 m" Tag="50"/>
                <ComboBoxItem Content="100 m" Tag="100" IsSelected="True"/>
                <ComboBoxItem Content="150 m" Tag="150"/>
                <ComboBoxItem Content="200 m" Tag="200"/>
            </ComboBox>

            <TextBlock Grid.Row="8" Text="최대 검색 반경" VerticalAlignment="Center"/>
            <StackPanel Grid.Row="8" Grid.Column="1" Margin="8">
                <ComboBox x:Name="RoadviewRadiusBox" Height="32">
                    <ComboBoxItem Content="50 m" Tag="50"/>
                    <ComboBoxItem Content="100 m" Tag="100" IsSelected="True"/>
                    <ComboBoxItem Content="150 m" Tag="150"/>
                    <ComboBoxItem Content="200 m" Tag="200"/>
                </ComboBox>
                <TextBlock Margin="0,5,0,0" Foreground="#777" TextWrapping="Wrap"
                           Text="서로 다른 pano 확보를 위해 먼저 후보점 주변 약 35m만 탐색하고, 부족할 때 방향·거리를 확장한 뒤 마지막에만 이 최대 반경을 사용합니다."/>
            </StackPanel>

            <TextBlock Grid.Row="9" Grid.ColumnSpan="2" Margin="8,18,8,8" Foreground="#666" TextWrapping="Wrap"
                       Text="AI 조감도 생성은 실제 사진을 참고해 시점을 재구성합니다. 구조 보존을 강하게 지시하지만 AI 결과이므로 측량·도면용 정확성을 보장하지 않습니다."/>

            <StackPanel Grid.Row="10" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Width="90" Height="34" Margin="4" Content="취소" IsCancel="True"/>
                <Button Width="90" Height="34" Margin="4" Content="생성" Click="Generate_Click" IsDefault="True"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
