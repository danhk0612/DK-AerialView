<Window x:Class="DKAerialView.RoadviewReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="카카오 로드뷰 참조 수집/확인"
        Width="1080" Height="820" MinWidth="860" MinHeight="680"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="125"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock FontSize="18" FontWeight="SemiBold"
                       Text="카카오 로드뷰를 수집하면서 바로 확인합니다."/>
            <TextBlock Margin="0,6,0,10" Foreground="#666" TextWrapping="Wrap"
                       Text="수집 성공 이미지는 즉시 아래에 표시됩니다. 수집 도중에도 확보된 사진만 선택해 생성하거나 항공사진만으로 진행할 수 있습니다."/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="CollectionStatusText" FontWeight="SemiBold" Text="로드뷰 수집 준비 중..."/>
                <TextBlock x:Name="CounterText" Grid.Column="1" Foreground="#555" Text="성공 0 · 중복 0 · 실패 0"/>
                <ProgressBar x:Name="CollectionProgressBar" Grid.Row="1" Grid.ColumnSpan="2" Height="14" Margin="0,8,0,0"
                             Minimum="0" Maximum="1" Value="0"/>
                <TextBlock x:Name="ProgressDetailText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,6,0,0"
                           Foreground="#666" Text="호스트 초기화를 기다리는 중입니다."/>
            </Grid>
        </Border>

        <Border Grid.Row="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <UniformGrid x:Name="ItemsPanel" Rows="2" Columns="2"/>
            </ScrollViewer>
        </Border>

        <GroupBox Grid.Row="3" Header="수집 로그" Margin="0,10,0,0">
            <ListBox x:Name="LogList" FontFamily="Consolas" FontSize="12" BorderThickness="0"/>
        </GroupBox>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Foreground="#555"
                       Text="로드뷰 0장 수집 · 0장 선택"/>
            <Button Grid.Column="1" Width="100" Height="34" Margin="6,0,0,0"
                    Content="취소" Click="Cancel_Click"/>
            <Button Grid.Column="2" Width="150" Height="34" Margin="6,0,0,0"
                    Content="항공사진만 진행" Click="AerialOnly_Click"/>
            <Button x:Name="ConfirmButton" Grid.Column="3" Width="180" Height="34" Margin="6,0,0,0"
                    Content="선택한 로드뷰로 생성" Click="Confirm_Click" IsDefault="True" IsEnabled="False"/>
        </Grid>
    </Grid>
</Window>
