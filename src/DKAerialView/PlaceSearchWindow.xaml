<Window x:Class="DKAerialView.PlaceSearchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="장소 검색 결과" Width="760" Height="520" MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Text="장소 검색 결과"/>
            <TextBlock Margin="0,4,0,10" Foreground="#666" Text="이동할 장소를 선택하세요. 더블클릭해도 바로 이동합니다."/>
        </StackPanel>

        <DataGrid x:Name="ResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" SelectionUnit="FullRow" MouseDoubleClick="ResultsGrid_MouseDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="장소명" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="분류" Binding="{Binding Category}" Width="1.4*"/>
                <DataGridTextColumn Header="주소" Binding="{Binding DisplayAddress}" Width="3*"/>
                <DataGridTextColumn Header="전화" Binding="{Binding Phone}" Width="1.3*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="90" Height="34" Margin="0,0,8,0" Content="취소" IsCancel="True"/>
            <Button Width="110" Height="34" Content="선택 위치로 이동" IsDefault="True" Click="Select_Click"/>
        </StackPanel>
    </Grid>
</Window>
