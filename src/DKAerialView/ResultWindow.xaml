<Window x:Class="DKAerialView.ResultWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK AerialView 결과" Width="1200" Height="760" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="12">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <GroupBox Header="원본" Grid.Row="0" Grid.Column="0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="SourceImage" Stretch="Uniform"/>
            </ScrollViewer>
        </GroupBox>

        <GroupBox Header="AI 결과" Grid.Row="0" Grid.Column="2">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image x:Name="ResultImage" Stretch="Uniform"/>
            </ScrollViewer>
        </GroupBox>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Width="100" Height="34" Margin="4" Content="닫기" IsCancel="True"/>
            <Button Width="120" Height="34" Margin="4" Content="결과 저장" Click="SaveResult_Click"/>
        </StackPanel>
    </Grid>
</Window>
