<Window x:Class="DKAerialView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DK AerialView" Width="1320" Height="820" MinWidth="1050" MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="AddressBox" Height="34" VerticalContentAlignment="Center" Margin="0,0,8,0"
                         ToolTip="주소를 입력하세요" KeyDown="AddressBox_KeyDown"/>
                <Button Grid.Column="1" Width="80" Height="34" Content="검색" Click="Search_Click"/>
                <Button Grid.Column="2" Width="80" Height="34" Margin="8,0,0,0" Content="설정" Click="Settings_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
            <Border Margin="12" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <wv2:WebView2 x:Name="MapWebView"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="4,12,12,12">
                <TextBlock Text="지도" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <ComboBox x:Name="ProviderBox" Height="32" SelectionChanged="ProviderBox_SelectionChanged">
                    <ComboBoxItem Content="Google" Tag="google" IsSelected="True"/>
                    <ComboBoxItem Content="Naver" Tag="naver"/>
                    <ComboBoxItem Content="Kakao" Tag="kakao"/>
                </ComboBox>

                <TextBlock Text="카메라" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,8"/>
                <TextBlock Text="Zoom"/>
                <Slider x:Name="ZoomSlider" Minimum="3" Maximum="22" Value="18" TickFrequency="0.5" ValueChanged="Camera_ValueChanged"/>
                <TextBlock x:Name="TiltLabel" Text="Tilt" Margin="0,10,0,0"/>
                <Slider x:Name="TiltSlider" Minimum="0" Maximum="67.5" Value="45" TickFrequency="5" ValueChanged="Camera_ValueChanged"/>
                <TextBlock x:Name="HeadingLabel" Text="Heading" Margin="0,10,0,0"/>
                <Slider x:Name="HeadingSlider" Minimum="0" Maximum="360" Value="315" TickFrequency="15" ValueChanged="Camera_ValueChanged"/>

                <TextBlock Text="구도 프리셋" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,8"/>
                <ComboBox x:Name="CameraPresetBox" Height="32" SelectionChanged="CameraPresetBox_SelectionChanged">
                    <ComboBoxItem Content="일반 조감도" Tag="18,45,315" IsSelected="True"/>
                    <ComboBoxItem Content="건물 중심" Tag="19,60,325"/>
                    <ComboBoxItem Content="넓은 부지" Tag="16.5,50,320"/>
                    <ComboBoxItem Content="수직 항공사진" Tag="19,0,0"/>
                </ComboBox>

                <TextBlock Text="출력" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,8"/>
                <ComboBox x:Name="OutputPresetBox" Height="32" SelectionChanged="OutputPresetBox_SelectionChanged">
                    <ComboBoxItem Content="FHD 1920 × 1080" Tag="1920,1080" IsSelected="True"/>
                    <ComboBoxItem Content="QHD 2560 × 1440" Tag="2560,1440"/>
                    <ComboBoxItem Content="UHD 3840 × 2160" Tag="3840,2160"/>
                    <ComboBoxItem Content="정사각형 2048 × 2048" Tag="2048,2048"/>
                </ComboBox>

                <Button x:Name="CaptureButton" Height="38" Margin="0,24,0,0" Content="현재 프레임 캡처" Click="Capture_Click" IsEnabled="False"/>
                <Button x:Name="EnhanceButton" Height="38" Margin="0,8,0,0" Content="AI 이미지 향상" Click="Enhance_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <StatusBar Grid.Row="2"><StatusBarItem><TextBlock x:Name="StatusText" Text="준비"/></StatusBarItem></StatusBar>
    </Grid>
</Window>
