<Window x:Class="DKAerialView.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="DK AerialView" Width="1320" Height="840" MinWidth="1050" MinHeight="670"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="12" BorderBrush="#DDD" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="AddressBox" Height="34" VerticalContentAlignment="Center" Margin="0,0,8,0"
                         ToolTip="주소, 건물명, 역명, 장소명을 입력하세요" KeyDown="AddressBox_KeyDown"/>
                <Button Grid.Column="1" Width="80" Height="34" Content="검색" Click="Search_Click"/>
                <Button Grid.Column="2" Width="80" Height="34" Margin="8,0,0,0" Content="설정" Click="Settings_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Margin="12" BorderBrush="#CCC" BorderThickness="1" CornerRadius="4" ClipToBounds="True">
                <wv2:WebView2 x:Name="MapWebView"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="4,12,12,12">
                <TextBlock Text="지도" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,8"/>
                <Border Padding="10,7" Background="#F3F3F3" CornerRadius="4">
                    <TextBlock Text="Kakao SkyView" FontWeight="SemiBold"/>
                </Border>
                <TextBlock Margin="0,7,0,0" Foreground="#666" TextWrapping="Wrap"
                           Text="지도 위: 왼쪽 드래그 이동 · 휠 미세 줌 · 오른쪽 드래그 회전"/>

                <TextBlock Text="화면 조정" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Zoom"/>
                    <TextBlock x:Name="ZoomValueText" Grid.Column="1" Text="18.0" Foreground="#666"/>
                </Grid>
                <Slider x:Name="ZoomSlider" Minimum="8" Maximum="21.9" Value="18" SmallChange="0.1" LargeChange="0.5"
                        TickFrequency="0.1" IsSnapToTickEnabled="False" ValueChanged="Camera_ValueChanged"/>

                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="2D 회전"/>
                    <TextBlock x:Name="HeadingValueText" Grid.Column="1" Text="0°" Foreground="#666"/>
                </Grid>
                <Slider x:Name="HeadingSlider" Minimum="0" Maximum="359" Value="0" SmallChange="1" LargeChange="15"
                        TickFrequency="5" IsSnapToTickEnabled="False" ValueChanged="Camera_ValueChanged"/>

                <TextBlock Text="구도 프리셋" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,8"/>
                <ComboBox x:Name="CameraPresetBox" Height="32" SelectionChanged="CameraPresetBox_SelectionChanged">
                    <ComboBoxItem Content="기본 항공" Tag="18,0" IsSelected="True"/>
                    <ComboBoxItem Content="건물 중심 확대" Tag="19,0"/>
                    <ComboBoxItem Content="넓은 부지" Tag="16.5,0"/>
                    <ComboBoxItem Content="대각 구도 45°" Tag="18,45"/>
                </ComboBox>

                <TextBlock Text="출력" FontWeight="SemiBold" FontSize="16" Margin="0,20,0,8"/>
                <ComboBox x:Name="OutputPresetBox" Height="32" SelectionChanged="OutputPresetBox_SelectionChanged">
                    <ComboBoxItem Content="FHD 1920 × 1080" Tag="1920,1080" IsSelected="True"/>
                    <ComboBoxItem Content="QHD 2560 × 1440" Tag="2560,1440"/>
                    <ComboBoxItem Content="UHD 3840 × 2160" Tag="3840,2160"/>
                    <ComboBoxItem Content="정사각형 2048 × 2048" Tag="2048,2048"/>
                </ComboBox>

                <Button x:Name="CaptureButton" Height="38" Margin="0,24,0,0" Content="현재 프레임 캡처" Click="Capture_Click" IsEnabled="False"/>
                <Button x:Name="EnhanceButton" Height="38" Margin="0,8,0,0" Content="AI 이미지 향상" Click="Enhance_Click" IsEnabled="False"/>
                <Button x:Name="GenerateAerialButton" Height="38" Margin="0,8,0,0" Content="AI 조감도 생성" Click="GenerateAerial_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>

        <StatusBar Grid.Row="2"><StatusBarItem><TextBlock x:Name="StatusText" Text="준비"/></StatusBarItem></StatusBar>
    </Grid>
</Window>
