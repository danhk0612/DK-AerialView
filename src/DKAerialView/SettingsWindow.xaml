<Window x:Class="DKAerialView.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK AerialView 설정" Width="720" Height="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Text="Google Maps API Key" VerticalAlignment="Center"/>
        <PasswordBox x:Name="GoogleKeyBox" Grid.Row="0" Grid.Column="1" Margin="8"/>
        <TextBlock Grid.Row="1" Text="Naver Client ID" VerticalAlignment="Center"/>
        <TextBox x:Name="NaverKeyBox" Grid.Row="1" Grid.Column="1" Margin="8"/>
        <TextBlock Grid.Row="2" Text="Kakao JavaScript Key" VerticalAlignment="Center"/>
        <PasswordBox x:Name="KakaoKeyBox" Grid.Row="2" Grid.Column="1" Margin="8"/>
        <TextBlock Grid.Row="3" Text="OpenRouter API Key" VerticalAlignment="Center"/>
        <PasswordBox x:Name="OpenRouterKeyBox" Grid.Row="3" Grid.Column="1" Margin="8"/>

        <TextBlock Grid.Row="4" Text="기본 이미지 모델" VerticalAlignment="Center"/>
        <Grid Grid.Row="4" Grid.Column="1" Margin="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="OpenRouterModelBox" Height="30" IsEditable="True"
                      DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                      SelectionChanged="OpenRouterModelBox_SelectionChanged"/>
            <Button x:Name="LoadModelsButton" Grid.Column="1" Width="100" Margin="8,0,0,0"
                    Content="목록 불러오기" Click="LoadModels_Click"/>
        </Grid>

        <TextBlock Grid.Row="5" Text="모델 기능" VerticalAlignment="Top" Margin="0,10,0,0"/>
        <TextBlock x:Name="ModelCapabilityText" Grid.Row="5" Grid.Column="1" Margin="8,10,8,8"
                   Foreground="#666" TextWrapping="Wrap"
                   Text="목록 불러오기를 누르면 참조 이미지/해상도/비율 지원 범위를 확인할 수 있습니다."/>

        <TextBlock Grid.Row="6" Text="AI 기본 프롬프트" VerticalAlignment="Top" Margin="0,12,0,0"/>
        <TextBox x:Name="OpenRouterPromptBox" Grid.Row="6" Grid.Column="1" Margin="8" Height="130"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Margin="8" Foreground="#666" TextWrapping="Wrap"
                   Text="지도/API 키는 로컬 설정 파일에만 저장됩니다. AI 향상에는 image input과 input_references를 지원하는 모델만 목록에 표시합니다."/>

        <StackPanel Grid.Row="8" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Width="90" Margin="4" Content="취소" IsCancel="True"/>
            <Button Width="90" Margin="4" Content="저장" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
