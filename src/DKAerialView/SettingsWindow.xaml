<Window x:Class="DKAerialView.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DK AerialView 설정" Width="760" Height="760"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Text="Kakao JavaScript Key" VerticalAlignment="Center"/>
            <PasswordBox x:Name="KakaoKeyBox" Grid.Row="0" Grid.Column="1" Margin="8"/>

            <TextBlock Grid.Row="1" Text="기본 출력 크기" VerticalAlignment="Center"/>
            <ComboBox x:Name="DefaultOutputBox" Grid.Row="1" Grid.Column="1" Height="30" Margin="8">
                <ComboBoxItem Content="FHD 1920 × 1080" Tag="1920x1080"/>
                <ComboBoxItem Content="QHD 2560 × 1440" Tag="2560x1440"/>
                <ComboBoxItem Content="UHD 3840 × 2160" Tag="3840x2160"/>
                <ComboBoxItem Content="정사각형 2048 × 2048" Tag="2048x2048"/>
            </ComboBox>

            <TextBlock Grid.Row="2" Text="OpenRouter API Key" VerticalAlignment="Center"/>
            <PasswordBox x:Name="OpenRouterKeyBox" Grid.Row="2" Grid.Column="1" Margin="8"/>

            <TextBlock Grid.Row="3" Text="기본 이미지 모델" VerticalAlignment="Center"/>
            <Grid Grid.Row="3" Grid.Column="1" Margin="8">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="OpenRouterModelBox" Height="30" IsEditable="True"
                          DisplayMemberPath="DisplayName" SelectedValuePath="Id"
                          SelectionChanged="OpenRouterModelBox_SelectionChanged"/>
                <Button x:Name="LoadModelsButton" Grid.Column="1" Width="100" Margin="8,0,0,0"
                        Content="목록 불러오기" Click="LoadModels_Click"/>
            </Grid>

            <TextBlock Grid.Row="4" Text="모델 기능" VerticalAlignment="Top" Margin="0,10,0,0"/>
            <TextBlock x:Name="ModelCapabilityText" Grid.Row="4" Grid.Column="1" Margin="8,10,8,8"
                       Foreground="#666" TextWrapping="Wrap"
                       Text="조감도에서 로드뷰를 함께 쓰려면 참조 이미지 최대 2장 이상인 모델이 필요합니다."/>

            <TextBlock Grid.Row="5" Text="AI 향상 프롬프트" VerticalAlignment="Top" Margin="0,12,0,0"/>
            <TextBox x:Name="OpenRouterPromptBox" Grid.Row="5" Grid.Column="1" Margin="8" Height="105"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Grid.Row="6" Text="AI 조감도 프롬프트" VerticalAlignment="Top" Margin="0,12,0,0"/>
            <TextBox x:Name="OpenRouterAerialPromptBox" Grid.Row="6" Grid.Column="1" Margin="8" Height="145"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Margin="8" Foreground="#666" TextWrapping="Wrap"
                       Text="Kakao Developers의 JavaScript SDK 도메인에는 https://app.dk-aerialview.local 을 등록하세요. 지도/API 키는 로컬 설정 파일에만 저장됩니다."/>

            <TextBlock Grid.Row="8" Grid.ColumnSpan="2" Margin="8" Foreground="#666" TextWrapping="Wrap"
                       Text="AI 향상과 AI 조감도 생성에는 image input과 input_references를 지원하는 OpenRouter 모델만 사용할 수 있습니다."/>

            <StackPanel Grid.Row="9" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="90" Margin="4" Content="취소" IsCancel="True"/>
                <Button Width="90" Margin="4" Content="저장" Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
